---
interface Props {
  chart: string;
  caption?: string;
}

const { chart, caption } = Astro.props;
---

<figure class="my-6 rounded-xl border border-neutral-200 bg-neutral-50/60 p-4 dark:border-neutral-800 dark:bg-neutral-900/50">
  <div class="mermaid overflow-x-auto text-center">{chart}</div>
  {caption && (
    <figcaption class="mt-2 text-center text-xs text-neutral-500 dark:text-neutral-400">
      {caption}
    </figcaption>
  )}
</figure>

<script type="module">
  import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";

  const isDark = () =>
    document.documentElement.classList.contains("dark") ||
    document.documentElement.dataset.theme === "dark";

  mermaid.initialize({
    startOnLoad: false,
    theme: isDark() ? "dark" : "default",
    securityLevel: "loose",
  });

  await mermaid.run({ querySelector: ".mermaid" });
</script>
